---
import BaseLayout from "@layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { apartments } from "@utils/realizacje";

const totalPairs = apartments.reduce((sum, a) => sum + a.pairs.length, 0);

function pairsLabel(n: number) {
    if (n === 1) return "para zdjęć";
    if (n >= 2 && n <= 4) return "pary zdjęć";
    return "par zdjęć";
}
---

<BaseLayout
    title="Realizacje – zdjęcia przed i po | Stabilny Najem"
    description="Zobacz, jak zmieniają się mieszkania pod naszą opieką. Konkretne, prawdziwe realizacje — stan przed renowacją i po, mieszkanie po mieszkaniu."
>
    <section id="realizacje-hero" class="realizacje-hero">
        <div class="section-container">
            <span class="section-tag">REALIZACJE</span>
            <h1 class="hero-title">Zdjęcia przed i&nbsp;po.</h1>
            <p class="hero-subtitle">
                Mieszkania, które przejęliśmy pod opiekę i&nbsp;odświeżyliśmy od&nbsp;A&nbsp;do&nbsp;Z. Prawdziwe adresy, konkretne lokalizacje — tak wyglądały przed przejęciem, i&nbsp;tak wyglądają teraz. {apartments.length}&nbsp;mieszkań, {totalPairs}&nbsp;par zdjęć przed i&nbsp;po.
            </p>
        </div>
    </section>

    <section id="realizacje-lista" class="realizacje-list">
        <div class="section-container">
            {
                apartments.map((apt) => (
                    <article
                        class="apartment"
                        id={`mieszkanie-${apt.slug}`}
                    >
                        <header class="apartment-header">
                            <h2 class="apartment-title">{apt.displayName}</h2>
                            <p class="apartment-meta">
                                {apt.pairs.length} {pairsLabel(apt.pairs.length)}
                            </p>
                        </header>
                        <div class="pairs-grid">
                            {apt.pairs.map((pair, i) => (
                                <div class="pair-row">
                                    <figure class="pair-tile">
                                        <button
                                            class="lightbox-trigger"
                                            type="button"
                                            aria-label={`Powiększ zdjęcie przed renowacją — ${apt.displayName}`}
                                        >
                                            <Image
                                                src={pair.przed}
                                                widths={[600, 1200, 1800]}
                                                sizes="(min-width: 64rem) 42vw, 100vw"
                                                alt={`${apt.displayName} – stan przed renowacją, ujęcie ${i + 1}`}
                                                class="pair-img"
                                                loading="lazy"
                                            />
                                            <span class="pair-label pair-label--before">
                                                Przed
                                            </span>
                                        </button>
                                    </figure>
                                    <figure class="pair-tile">
                                        <button
                                            class="lightbox-trigger"
                                            type="button"
                                            aria-label={`Powiększ zdjęcie po renowacji — ${apt.displayName}`}
                                        >
                                            <Image
                                                src={pair.po}
                                                widths={[600, 1200, 1800]}
                                                sizes="(min-width: 64rem) 42vw, 100vw"
                                                alt={`${apt.displayName} – stan po renowacji, ujęcie ${i + 1}`}
                                                class="pair-img"
                                                loading="lazy"
                                            />
                                            <span class="pair-label pair-label--after">
                                                Po
                                            </span>
                                        </button>
                                    </figure>
                                </div>
                            ))}
                        </div>
                    </article>
                ))
            }
        </div>
    </section>

    <div
        id="lightbox"
        class="lightbox"
        role="dialog"
        aria-modal="true"
        aria-hidden="true"
    >
        <button class="lightbox-close" type="button" aria-label="Zamknij"
            >&times;</button
        >
        <button class="lightbox-nav lightbox-prev" type="button" aria-label="Poprzednie zdjęcie">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button class="lightbox-nav lightbox-next" type="button" aria-label="Następne zdjęcie">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
        </button>
        <img id="lightbox-img" class="lightbox-img" alt="" />
    </div>
</BaseLayout>

<style>
    .realizacje-hero {
        padding-top: calc(var(--h-menu-bar) + var(--px-64));
        padding-bottom: var(--px-80);
        background-color: var(--color-background);
    }

    .hero-title {
        font-size: clamp(2.25rem, 4vw + var(--text-lg), 4rem);
        font-weight: 500;
        line-height: 1.1;
        color: var(--color-text-primary);
        margin-bottom: var(--px-24);
    }

    .hero-subtitle {
        font-size: var(--text-xl);
        max-width: 50rem;
        color: var(--color-text-secondary);
        opacity: 1;
        line-height: 1.55;
    }

    .realizacje-list {
        background-color: var(--color-white);
    }

    .apartment {
        margin-bottom: var(--px-128);
    }
    .apartment:last-child {
        margin-bottom: 0;
    }

    .apartment-header {
        margin-bottom: var(--px-40);
        padding-bottom: var(--px-24);
        border-bottom: 1px solid var(--color-border);
    }

    .apartment-title {
        font-size: clamp(1.75rem, 2.5vw + var(--text-lg), 2.75rem);
        font-weight: 500;
        color: var(--color-text-primary);
        margin-bottom: var(--px-8);
        letter-spacing: -0.01em;
    }

    .apartment-meta {
        font-size: var(--text-xs);
        letter-spacing: 0.12em;
        color: var(--color-text-secondary);
        text-transform: uppercase;
        opacity: 1;
    }

    .pairs-grid {
        display: flex;
        flex-direction: column;
        gap: var(--px-32);
    }

    .pair-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--px-24);
    }

    .pair-tile {
        position: relative;
        margin: 0;
        overflow: hidden;
        border-radius: var(--radius-md);
        background-color: var(--color-background);
        box-shadow: var(--shadow-sm);
    }

    .lightbox-trigger {
        display: block;
        width: 100%;
        padding: 0;
        border: none;
        background: transparent;
        cursor: zoom-in;
        position: relative;
        aspect-ratio: 4 / 3;
        overflow: hidden;
    }

    .pair-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform var(--transition-long);
        display: block;
    }

    .pair-label {
        position: absolute;
        top: var(--px-16);
        left: var(--px-16);
        color: var(--color-white);
        font-size: var(--text-xs);
        letter-spacing: 0.14em;
        font-weight: 600;
        padding: var(--px-6) var(--px-14);
        border-radius: var(--radius-sm);
        text-transform: uppercase;
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
    }

    .pair-label--before {
        background: rgba(45, 59, 45, 0.85);
    }

    .pair-label--after {
        background: rgba(184, 134, 11, 0.92);
    }

    @media (hover: hover) and (pointer: fine) {
        .lightbox-trigger:hover .pair-img {
            transform: scale(1.025);
        }
    }

    /* Lightbox */
    .lightbox {
        position: fixed;
        inset: 0;
        background: rgba(45, 59, 45, 0.96);
        z-index: var(--z-max);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: var(--px-32);
        opacity: 0;
        visibility: hidden;
        transition:
            opacity var(--transition-medium),
            visibility var(--transition-medium);
        cursor: zoom-out;
    }
    .lightbox.active {
        opacity: 1;
        visibility: visible;
    }
    .lightbox-img {
        max-width: 95vw;
        max-height: 88vh;
        width: auto;
        height: auto;
        object-fit: contain;
        box-shadow: var(--shadow-lg);
        border-radius: var(--radius-sm);
    }
    .lightbox-close {
        position: absolute;
        top: var(--px-24);
        right: var(--px-24);
        width: var(--px-48);
        height: var(--px-48);
        border-radius: 50%;
        border: none;
        background: rgba(255, 255, 255, 0.15);
        color: var(--color-white);
        font-size: 1.75rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
        transition: background var(--transition-short);
    }
    .lightbox-close:hover {
        background: rgba(255, 255, 255, 0.3);
    }

    .lightbox-nav {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: 3.5rem;
        height: 3.5rem;
        border-radius: 50%;
        border: none;
        background: rgba(255, 255, 255, 0.15);
        color: var(--color-white);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background var(--transition-short);
        z-index: 2;
    }
    .lightbox-nav:hover {
        background: rgba(255, 255, 255, 0.3);
    }
    .lightbox-prev {
        left: var(--px-24);
    }
    .lightbox-next {
        right: var(--px-24);
    }

    @media screen and (max-width: 48rem) {
        .lightbox-nav {
            width: 2.75rem;
            height: 2.75rem;
        }
        .lightbox-prev { left: var(--px-8); }
        .lightbox-next { right: var(--px-8); }
    }

    @media screen and (max-width: 64rem) {
        .apartment {
            margin-bottom: var(--px-96);
        }
    }

    @media screen and (max-width: 48rem) {
        .realizacje-hero {
            padding-top: calc(var(--h-menu-bar) + var(--px-32));
            padding-bottom: var(--px-48);
        }
        .pair-row {
            grid-template-columns: 1fr;
            gap: var(--px-12);
        }
        .pairs-grid {
            gap: var(--px-24);
        }
        .apartment {
            margin-bottom: var(--px-64);
        }
        .apartment-header {
            margin-bottom: var(--px-24);
        }
        .pair-label {
            top: var(--px-12);
            left: var(--px-12);
            font-size: 0.7rem;
            padding: var(--px-4) var(--px-10);
        }
    }
</style>

<script>
    function initLightbox() {
        const lightbox = document.getElementById("lightbox") as HTMLElement | null;
        const img = document.getElementById("lightbox-img") as HTMLImageElement | null;
        const closeBtn = lightbox?.querySelector(".lightbox-close") as HTMLElement | null;
        const prevBtn = lightbox?.querySelector(".lightbox-prev") as HTMLElement | null;
        const nextBtn = lightbox?.querySelector(".lightbox-next") as HTMLElement | null;
        if (!lightbox || !img) return;

        const triggers = Array.from(
            document.querySelectorAll<HTMLButtonElement>(".lightbox-trigger"),
        );
        let currentIndex = -1;

        function showAt(index: number) {
            if (index < 0 || index >= triggers.length) return;
            currentIndex = index;
            const target = triggers[index].querySelector("img") as HTMLImageElement | null;
            if (!target) return;
            img!.srcset = target.srcset;
            img!.sizes = "100vw";
            img!.src = target.currentSrc || target.src;
            img!.alt = target.alt;
        }

        function openAt(index: number) {
            showAt(index);
            lightbox!.classList.add("active");
            lightbox!.setAttribute("aria-hidden", "false");
            document.body.classList.add("no-scroll");
        }
        function closeLightbox() {
            lightbox!.classList.remove("active");
            lightbox!.setAttribute("aria-hidden", "true");
            document.body.classList.remove("no-scroll");
            currentIndex = -1;
        }
        function next() {
            if (currentIndex < 0) return;
            showAt((currentIndex + 1) % triggers.length);
        }
        function prev() {
            if (currentIndex < 0) return;
            showAt((currentIndex - 1 + triggers.length) % triggers.length);
        }

        function onClick(e: MouseEvent) {
            const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".lightbox-trigger");
            if (!btn) return;
            const index = triggers.indexOf(btn);
            if (index >= 0) openAt(index);
        }
        function onLightboxClick(e: MouseEvent) {
            const target = e.target as HTMLElement;
            if (target === img) return;
            if (target.closest(".lightbox-nav")) return;
            if (target.closest(".lightbox-close")) return;
            closeLightbox();
        }
        function onKey(e: KeyboardEvent) {
            if (!lightbox!.classList.contains("active")) return;
            if (e.key === "Escape") {
                e.preventDefault();
                closeLightbox();
            } else if (e.key === "ArrowRight") {
                e.preventDefault();
                next();
            } else if (e.key === "ArrowLeft") {
                e.preventDefault();
                prev();
            }
        }

        document.addEventListener("click", onClick);
        lightbox.addEventListener("click", onLightboxClick);
        document.addEventListener("keydown", onKey);
        closeBtn?.addEventListener("click", (e) => { e.stopPropagation(); closeLightbox(); });
        prevBtn?.addEventListener("click", (e) => { e.stopPropagation(); prev(); });
        nextBtn?.addEventListener("click", (e) => { e.stopPropagation(); next(); });
    }

    initLightbox();
</script>
