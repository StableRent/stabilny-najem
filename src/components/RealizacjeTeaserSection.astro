---
import { Image } from "astro:assets";
import przedImg from "@assets/realizacje/bobrzynskiego-45/przed-1.jpg";
import poImg from "@assets/realizacje/bobrzynskiego-45/po-1.jpg";
---

<section id="realizacje-teaser" class="teaser">
    <div class="section-container teaser-grid">
        <div class="teaser-copy">
            <span class="teaser-tag">REALIZACJE</span>
            <h2 class="teaser-title">Zobacz, jak dbamy o&nbsp;mieszkania</h2>
            <p class="teaser-text">
                Mieszkania u&nbsp;nas nie tracą — zyskują. Zobacz metamorfozy lokali, które przejęliśmy i&nbsp;przygotowaliśmy do wynajmu.
            </p>
            <a href="/realizacje" class="teaser-cta">
                Zobacz realizacje
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14M13 5l7 7-7 7"/>
                </svg>
            </a>
        </div>

        <a href="/realizacje" class="teaser-preview" aria-label="Zobacz realizacje przed i po">
            <figure class="teaser-figure">
                <Image src={przedImg} widths={[400, 700]} sizes="(min-width: 48rem) 22vw, 45vw" alt="Mieszkanie przed przejęciem" class="teaser-img" />
                <figcaption class="teaser-caption teaser-caption--before">Przed</figcaption>
            </figure>
            <figure class="teaser-figure">
                <Image src={poImg} widths={[400, 700]} sizes="(min-width: 48rem) 22vw, 45vw" alt="To samo mieszkanie po przygotowaniu" class="teaser-img" />
                <figcaption class="teaser-caption teaser-caption--after">Po</figcaption>
            </figure>
        </a>
    </div>
</section>

<style>
    .teaser {
        background-color: var(--color-white);
        padding-block: var(--px-112);
    }

    .teaser-grid {
        display: grid;
        grid-template-columns: 1fr 1.1fr;
        gap: var(--px-80);
        align-items: center;
        max-width: 90rem;
        margin: 0 auto;
    }

    .teaser-tag {
        display: inline-block;
        font-size: var(--text-xs);
        font-weight: 700;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--color-accent);
        margin-bottom: var(--px-16);
    }

    .teaser-title {
        font-size: clamp(2rem, 3.5vw, 2.75rem);
        font-weight: 700;
        color: var(--color-primary);
        letter-spacing: -0.01em;
        line-height: 1.15;
        margin-bottom: var(--px-24);
    }

    .teaser-text {
        font-size: clamp(1.05rem, 1.35vw, 1.2rem);
        line-height: 1.7;
        color: var(--color-text-dark);
        margin-bottom: var(--px-40);
        max-width: 32rem;
    }

    .teaser-cta {
        display: inline-flex;
        align-items: center;
        gap: var(--px-10);
        padding: var(--px-16) var(--px-32);
        background: var(--color-primary);
        color: var(--color-white);
        font-weight: 600;
        font-size: var(--text-base);
        letter-spacing: 0.02em;
        border-radius: var(--radius-sm);
        transition: all var(--transition-short);
    }

    .teaser-cta svg {
        transition: transform var(--transition-short);
    }

    .teaser-preview {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--px-16);
    }

    .teaser-figure {
        position: relative;
        margin: 0;
        aspect-ratio: 4 / 5;
        overflow: hidden;
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-md);
    }

    .teaser-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform var(--transition-long);
        display: block;
    }

    .teaser-caption {
        position: absolute;
        top: var(--px-14);
        left: var(--px-14);
        padding: var(--px-4) var(--px-12);
        font-size: var(--text-xs);
        letter-spacing: 0.14em;
        text-transform: uppercase;
        font-weight: 600;
        color: var(--color-white);
        border-radius: var(--radius-sm);
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
    }

    .teaser-caption--before {
        background: rgba(45, 59, 45, 0.85);
    }

    .teaser-caption--after {
        background: rgba(184, 134, 11, 0.92);
    }

    @media (hover: hover) and (pointer: fine) {
        .teaser-cta:hover {
            background: var(--color-secondary);
        }

        .teaser-cta:hover svg {
            transform: translateX(4px);
        }

        .teaser-preview:hover .teaser-img {
            transform: scale(1.03);
        }
    }

    @media screen and (max-width: 64rem) {
        .teaser-grid {
            grid-template-columns: 1fr;
            gap: var(--px-48);
        }
    }

    @media screen and (max-width: 48rem) {
        .teaser {
            padding-block: var(--px-80);
        }
    }
</style>
