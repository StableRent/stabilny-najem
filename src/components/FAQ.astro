---
const faqItems = [
  {
    id: 1,
    question: 'Z kim dokładnie podpisuję umowę?',
    answer:
      'Z firmą Stabilny Najem Bolesław Stopa, NIP 735-292-90-46 — jednym, konkretnym podmiotem z adresem i odpowiedzialnością. To istotna różnica wobec wynajmu anonimowej osobie prywatnej.',
  },
  {
    id: 2,
    question: 'Co z naprawami i drobnymi usterkami?',
    answer:
      'Wszystkie bieżące naprawy i usterki bierzemy na siebie — od cieknącego kranu po drobne prace w mieszkaniu. Nie zawracamy Ci tym głowy; to nasza rola i nasz koszt. Ty masz z mieszkania sam czynsz, bez telefonów o 22:00.',
  },
  {
    id: 3,
    question: 'Czy mogę zobaczyć swoje mieszkanie w trakcie współpracy?',
    answer:
      'Oczywiście. Po umówieniu terminu masz pełne prawo wejść i sprawdzić stan lokalu. Działamy w pełni transparentnie.',
  },
  {
    id: 4,
    question: 'Czy coś mnie to kosztuje na start?',
    answer:
      'Nie. Nie pobieramy żadnych opłat wstępnych — to my inwestujemy w przygotowanie mieszkania.',
  },
];
---

<section id="faq" class="faq">
  <div class="section-container faq-container">
    <div class="faq-header">
      <span class="section-tag">FAQ</span>
      <h2 class="section-title">Częste pytania</h2>
      <p class="faq-lede">Odpowiedzi na to, o co właściciele pytają nas najczęściej. Nie znalazłeś swojego pytania? Zadzwoń — omówimy Twój konkretny przypadek.</p>
    </div>

    <div class="faq-content">
      <div class="accordion">
        {
          faqItems.map(item => (
            <div class="accordion-item">
              <button class="accordion-button">
                <span class="button-text">{item.question}</span>
                <svg
                  class="button-icon"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </button>
              <div class="accordion-content">
                <div class="content-wrapper">
                  <p>{item.answer}</p>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .faq {
    background-color: var(--color-white);
    padding-block: var(--px-112);
  }

  .faq-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--px-64);
    align-items: start;
    max-width: 90rem;
    margin: 0 auto;
  }

  .faq-header {
    position: sticky;
    top: calc(var(--h-menu-bar) + var(--px-32));
    max-width: 90%;
  }

  .faq-header .section-tag {
    color: var(--color-accent);
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .faq-header .section-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: var(--px-24);
    letter-spacing: -0.01em;
    line-height: 1.15;
  }

  .faq-lede {
    font-size: clamp(1.05rem, 1.35vw, 1.15rem);
    line-height: 1.7;
    color: var(--color-text-dark);
  }

  .accordion {
    display: flex;
    flex-direction: column;
  }

  .accordion-item {
    border-bottom: var(--px-1) solid var(--color-border);
  }

  .accordion-content .content-wrapper p {
    color: var(--color-text-dark);
    font-size: var(--text-base);
    line-height: 1.7;
    padding-right: var(--px-24);
  }

  .accordion-button {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--px-16);
    padding: var(--px-20) 0;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    transition: all var(--transition-long);
  }

  .button-text {
    font-size: var(--text-xl);
    font-weight: 500;
    color: var(--color-primary);
    transition: all var(--transition-long);
  }

  .button-icon {
    width: var(--px-20);
    height: var(--px-20);
    transition: all var(--transition-long);
    flex-shrink: 0;
  }

  .accordion-item.active .button-text {
    font-weight: 500;
  }

  .accordion-item.active .button-icon {
    transform: rotate(45deg);
  }

  .accordion-content {
    height: 0;
    overflow: hidden;
    transition: height var(--transition-long);
  }

  .content-wrapper {
    padding-bottom: 0.813rem;
    opacity: 0;
    transform: translateY(10px);
    transition: all var(--transition-long);
  }

  .accordion-item.active .content-wrapper {
    opacity: 1;
    transform: translateY(0);
  }

  @media (hover: hover) and (pointer: fine) {
    .accordion-button:hover .button-text,
    .accordion-button:hover .button-icon {
      opacity: 0.65;
    }
  }

  @media (max-width: 64rem) {
    .faq-container {
      gap: var(--px-32);
    }
  }

  @media (max-width: 48rem) {
    .faq-container {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .faq-header {
      position: static;
      max-width: none;
    }

    .section-title {
      margin-bottom: var(--px-44);
    }
  }
</style>

<script>
  function initFAQAccordion() {
    const accordionContainer = document.querySelector('.faq-container');

    if (!accordionContainer) return;

    accordionContainer.addEventListener('click', e => {
      const button = (e.target as HTMLElement).closest('.accordion-button');

      if (!button) return;

      const item = button.closest('.accordion-item');
      const content = item?.querySelector<HTMLElement>('.accordion-content');

      if (!item || !content) return;

      const isActive = item.classList.contains('active');

      document.querySelectorAll('.accordion-item.active').forEach(accItem => {
        const accContent =
          accItem.querySelector<HTMLElement>('.accordion-content');
        const accButton = accItem.querySelector('.accordion-button');

        if (!accContent || !accButton) return;

        if (accItem !== item) {
          accItem.classList.remove('active');
          accContent.style.height = '0';
          accButton.setAttribute('aria-expanded', 'false');
          accContent.setAttribute('aria-hidden', 'true');
        }
      });

      if (!isActive) {
        item.classList.add('active');
        content.style.height = content.scrollHeight + 'px';
        button.setAttribute('aria-expanded', 'true');
        content.setAttribute('aria-hidden', 'false');
      } else {
        item.classList.remove('active');
        content.style.height = '0';
        button.setAttribute('aria-expanded', 'false');
        content.setAttribute('aria-hidden', 'true');
      }
    });
  }

  initFAQAccordion();
  document.addEventListener('astro:after-swap', initFAQAccordion);
</script>
