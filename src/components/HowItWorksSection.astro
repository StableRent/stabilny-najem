---
import { Image } from "astro:assets";
import gridImg1 from "@assets/realizacje/bobrzynskiego-45/po-1.jpg";
import gridImg2 from "@assets/realizacje/dukatow-1/po-1.jpg";
import gridImg3 from "@assets/realizacje/kluczborska-25/po-1.jpg";
import gridImg4 from "@assets/realizacje/siemienskiego-1/po-1.jpg";

const gridImages = [
    { src: gridImg1, label: "Bobrzyńskiego 45" },
    { src: gridImg2, label: "Dukatów 1" },
    { src: gridImg3, label: "Kluczborska 25" },
    { src: gridImg4, label: "Siemieńskiego 1" },
];

const responsibilities = [
    "Przygotowanie i odświeżenie mieszkania",
    "Ogłoszenia, telefony, prezentacje",
    "Weryfikacja i selekcja najemców",
    "Umowy, protokoły, rozliczenia",
    "Płatności i windykacja",
    "Naprawy i bieżące usterki",
    "Kontakt z lokatorami",
    "Ryzyko pustostanu",
    "Drobne kryzysy i „co teraz?”",
];
---

<section id="how-it-works" class="process">
    <div class="section-container">
        <div class="process-header">
            <span class="process-tag">JAK TO DZIAŁA</span>
            <h2 class="process-title">Jak to działa i&nbsp;dlaczego to bezpieczne</h2>
        </div>

        <div class="process-text">
            <p>Podpisujemy zwykłą umowę najmu — ale z&nbsp;firmą, nie z&nbsp;lokatorem prywatnym. Dzięki temu masz po drugiej stronie jeden profesjonalny podmiot, jasne warunki współpracy i&nbsp;większe bezpieczeństwo niż przy klasycznym najmie osobie fizycznej.</p>
            <p>To umowa taka sama jak każda inna, z&nbsp;jednym dodatkowym zapisem — Twoją pisemną zgodą na to, byśmy mogli dalej udostępniać lokal osobom, które będą w&nbsp;nim mieszkać. Pozwala na to art.&nbsp;688<sup>2</sup> Kodeksu cywilnego i&nbsp;na tym opiera się cała współpraca.</p>
            <p>Mieszkania wynajmujemy młodym, pracującym i&nbsp;studiującym osobom, które wcześniej sami dokładnie weryfikujemy — masz więc pewność, kto u&nbsp;Ciebie mieszka. Przez cały czas trwania umowy odpowiadamy też za stan lokalu.</p>
            <p>Po podpisaniu umowy przejmujemy mieszkanie, odświeżamy je i&nbsp;zajmujemy się znalezieniem najemców, płatnościami, usterkami i&nbsp;bieżącymi sprawami. Ty otrzymujesz stały czynsz co&nbsp;miesiąc — bez ryzyka pustostanów, bez kontaktu z&nbsp;najemcami i&nbsp;bez angażowania Twojego czasu.</p>
        </div>

        <h3 class="process-punchline">Twoja jedyna rola: <em>odebrać czynsz.</em></h3>

        <div class="process-split">
            <div class="responsibilities">
                <div class="resp-column resp-yours">
                    <div class="resp-head">
                        <span class="resp-head-label">Zostaje po Twojej stronie</span>
                    </div>
                    <ul class="resp-list">
                        <li>Odbieranie stałego czynszu</li>
                        <li class="resp-and-thats-it">…i&nbsp;tyle.</li>
                    </ul>
                </div>
                <div class="resp-column resp-ours">
                    <div class="resp-head">
                        <span class="resp-head-label">Bierzemy na siebie</span>
                    </div>
                    <ul class="resp-list">
                        {responsibilities.map(item => (
                            <li>{item}</li>
                        ))}
                    </ul>
                </div>
            </div>

            <a href="/realizacje" class="process-grid" aria-label="Zobacz nasze realizacje">
                {gridImages.map((img) => (
                    <figure class="process-grid-item">
                        <Image
                            src={img.src}
                            widths={[300, 600]}
                            sizes="(min-width: 64rem) 20vw, 45vw"
                            alt={`Realizacja: ${img.label}`}
                            class="process-grid-img"
                            loading="lazy"
                        />
                        <figcaption class="process-grid-caption">{img.label}</figcaption>
                    </figure>
                ))}
            </a>
        </div>
    </div>
</section>

<style>
    .process {
        background-color: var(--color-background);
        padding-block: var(--px-112);
    }

    .process-header {
        max-width: 60rem;
        margin-bottom: var(--px-48);
    }

    .process-tag {
        display: inline-block;
        font-size: var(--text-xs);
        font-weight: 700;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--color-accent);
        margin-bottom: var(--px-16);
    }

    .process-title {
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 700;
        color: var(--color-primary);
        letter-spacing: -0.01em;
        line-height: 1.15;
    }

    .process-text {
        display: flex;
        flex-direction: column;
        gap: var(--px-24);
        max-width: 62rem;
        font-size: clamp(1.05rem, 1.35vw, 1.15rem);
        line-height: 1.75;
        color: var(--color-text-dark);
        margin-bottom: var(--px-80);
    }

    .process-text p {
        opacity: 0.92;
    }

    .process-punchline {
        font-size: clamp(1.5rem, 2.5vw, 2rem);
        font-weight: 700;
        color: var(--color-primary);
        letter-spacing: -0.01em;
        margin-bottom: var(--px-40);
    }

    .process-punchline em {
        font-style: italic;
        font-weight: 700;
        color: var(--color-accent);
    }

    .process-split {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--px-64);
        align-items: stretch;
    }

    .responsibilities {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--px-24);
    }

    .resp-column {
        background: var(--color-white);
        border-radius: var(--radius-md);
        padding: var(--px-24);
        border: 1px solid var(--color-border);
    }

    .resp-yours {
        border-top: 3px solid var(--color-accent);
    }

    .resp-ours {
        border-top: 3px solid var(--color-primary);
    }

    .resp-head {
        margin-bottom: var(--px-20);
        padding-bottom: var(--px-14);
        border-bottom: 1px solid var(--color-border);
    }

    .resp-head-label {
        font-size: var(--text-xs);
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--color-text-secondary);
    }

    .resp-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: var(--px-12);
    }

    .resp-list li {
        font-size: var(--text-base);
        line-height: 1.5;
        color: var(--color-text-dark);
        padding-left: var(--px-18);
        position: relative;
    }

    .resp-list li::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.55em;
        width: 6px;
        height: 6px;
        border-radius: 50%;
    }

    .resp-yours .resp-list li::before {
        background: var(--color-accent);
    }

    .resp-ours .resp-list li::before {
        background: var(--color-primary);
    }

    .resp-and-thats-it {
        color: var(--color-text-secondary) !important;
        font-style: italic;
        padding-left: 0 !important;
    }

    .resp-and-thats-it::before {
        display: none;
    }

    .process-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--px-12);
        align-content: start;
    }

    .process-grid-item {
        position: relative;
        margin: 0;
        aspect-ratio: 4 / 3;
        overflow: hidden;
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-sm);
    }

    .process-grid-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform var(--transition-long);
    }

    .process-grid-caption {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: var(--px-14) var(--px-16);
        font-size: var(--text-xs);
        font-weight: 600;
        letter-spacing: 0.06em;
        color: var(--color-white);
        background: linear-gradient(
            180deg,
            rgba(0, 0, 0, 0) 0%,
            rgba(0, 0, 0, 0.65) 100%
        );
    }

    @media (hover: hover) and (pointer: fine) {
        .process-grid:hover .process-grid-img {
            transform: scale(1.03);
        }
    }

    @media screen and (max-width: 64rem) {
        .process-split {
            grid-template-columns: 1fr;
            gap: var(--px-40);
        }

        .process-grid {
            order: -1;
        }
    }

    @media screen and (max-width: 48rem) {
        .process {
            padding-block: var(--px-80);
        }

        .responsibilities {
            grid-template-columns: 1fr;
        }

        .process-text {
            margin-bottom: var(--px-56);
        }
    }
</style>
