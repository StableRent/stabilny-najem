---
import { Image } from "astro:assets";
import gridImg1 from "@assets/realizacje/bobrzynskiego-45/po-1.jpg";
import gridImg2 from "@assets/showcase/lipinskiego-8.jpg";
import gridImg3 from "@assets/realizacje/kluczborska-25/po-1.jpg";
import gridImg4 from "@assets/showcase/opolska-21.jpg";

const gridImages = [
    { src: gridImg1, label: "Bobrzyńskiego 45" },
    { src: gridImg2, label: "Lipińskiego 8" },
    { src: gridImg3, label: "Kluczborska 25" },
    { src: gridImg4, label: "Opolska 21" },
];

const responsibilities = [
    "Przygotowanie i odświeżenie mieszkania",
    "Ogłoszenia, telefony, prezentacje",
    "Weryfikacja i selekcja najemców",
    "Umowy, protokoły, rozliczenia",
    "Płatności i windykacja",
    "Naprawy i bieżące usterki",
    "Kontakt z lokatorami",
    "Ryzyko pustostanu",
    "Drobne kryzysy i „co teraz?”",
];
---

<section id="how-it-works" class="process">
    <div class="section-container">
        <div class="process-header">
            <span class="process-tag">JAK TO DZIAŁA</span>
            <h2 class="process-title">Jak to działa i&nbsp;dlaczego to bezpieczne</h2>
        </div>

        <div class="process-text">
            <p>Podpisujemy zwykłą umowę najmu — ale z&nbsp;firmą, nie z&nbsp;lokatorem prywatnym. Dzięki temu masz po drugiej stronie jeden profesjonalny podmiot, jasne warunki współpracy i&nbsp;dużo większe bezpieczeństwo niż przy klasycznym najmie osobie fizycznej — nas jako firmy nie chroni ustawa o&nbsp;ochronie praw lokatorów, więc Twoja pozycja jako właściciela jest zdecydowanie mocniejsza.</p>
            <p>To umowa taka sama jak każda inna, z&nbsp;jednym dodatkowym zapisem — Twoją pisemną zgodą na to, byśmy mogli dalej udostępniać lokal osobom, które będą w&nbsp;nim mieszkać. Pozwala na to art.&nbsp;688<sup>2</sup> Kodeksu cywilnego i&nbsp;na tym opiera się cała współpraca.</p>
            <p>Mieszkania wynajmujemy spokojnym, młodym, studiująco-pracującym osobom, które wcześniej sami dokładnie weryfikujemy — masz więc pewność, kto u&nbsp;Ciebie mieszka. Przez cały czas trwania umowy odpowiadamy też za stan lokalu.</p>
            <p>Po podpisaniu umowy przejmujemy mieszkanie. <strong>Odświeżamy je, znajdujemy najemców, obsługujemy płatności, usterki i&nbsp;bieżące sprawy.</strong> Ty otrzymujesz stały czynsz co&nbsp;miesiąc — bez ryzyka pustostanów, bez kontaktu z&nbsp;najemcami i&nbsp;bez angażowania Twojego czasu.</p>
        </div>

        <h3 class="process-punchline">Twoja jedyna rola: <em>odebrać czynsz.</em></h3>

        <div class="process-split">
            <div class="responsibilities">
                <div class="resp-column resp-yours">
                    <div class="resp-head">
                        <span class="resp-head-label">Zostaje po Twojej stronie</span>
                    </div>
                    <ul class="resp-list">
                        <li>Odbieranie stałego czynszu</li>
                        <li class="resp-and-thats-it">…i&nbsp;tyle.</li>
                    </ul>
                </div>
                <div class="resp-column resp-ours">
                    <div class="resp-head">
                        <span class="resp-head-label">Bierzemy na siebie</span>
                    </div>
                    <ul class="resp-list">
                        {responsibilities.map(item => (
                            <li>{item}</li>
                        ))}
                    </ul>
                </div>
            </div>

            <div class="process-grid-wrapper">
                <div class="process-grid">
                    {gridImages.map((img) => (
                        <button type="button" class="process-grid-item process-lightbox-trigger" aria-label={`Powiększ: ${img.label}`}>
                            <Image
                                src={img.src}
                                widths={[400, 800, 1400]}
                                sizes="(min-width: 64rem) 30vw, 50vw"
                                alt={`Realizacja: ${img.label}`}
                                class="process-grid-img"
                                loading="lazy"
                            />
                            <span class="process-grid-caption">{img.label}</span>
                        </button>
                    ))}
                </div>
                <a href="/realizacje" class="process-grid-cta">
                    Zobacz wszystkie realizacje
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14M13 5l7 7-7 7"/>
                    </svg>
                </a>
            </div>
        </div>

        <div id="process-lightbox" class="process-lightbox" role="dialog" aria-modal="true" aria-hidden="true">
            <button class="process-lightbox-close" type="button" aria-label="Zamknij">&times;</button>
            <img id="process-lightbox-img" class="process-lightbox-img" alt="" />
        </div>
    </div>
</section>

<style>
    .process {
        background-color: var(--color-background);
        padding-block: var(--px-112);
    }

    .process-header {
        max-width: 60rem;
        margin-bottom: var(--px-48);
    }

    .process-tag {
        display: inline-block;
        font-size: var(--text-xs);
        font-weight: 700;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--color-accent);
        margin-bottom: var(--px-16);
    }

    .process-title {
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 700;
        color: var(--color-primary);
        letter-spacing: -0.01em;
        line-height: 1.15;
    }

    .process-text {
        display: flex;
        flex-direction: column;
        gap: var(--px-24);
        max-width: 62rem;
        font-size: clamp(1.05rem, 1.35vw, 1.15rem);
        line-height: 1.75;
        color: var(--color-text-dark);
        margin-bottom: var(--px-80);
    }

    .process-text p {
        opacity: 0.92;
    }

    .process-text strong {
        color: var(--color-primary);
        font-weight: 700;
    }

    .process-punchline {
        font-size: clamp(1.5rem, 2.5vw, 2rem);
        font-weight: 700;
        color: var(--color-primary);
        letter-spacing: -0.01em;
        margin-bottom: var(--px-40);
    }

    .process-punchline em {
        font-style: italic;
        font-weight: 700;
        color: var(--color-accent);
    }

    .process-split {
        display: grid;
        grid-template-columns: 1fr 1.75fr;
        gap: var(--px-48);
        align-items: start;
    }

    .responsibilities {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--px-16);
        align-items: start;
    }

    .resp-column {
        background: var(--color-white);
        border-radius: var(--radius-md);
        padding: var(--px-24);
        border: 1px solid var(--color-border);
    }

    .resp-yours {
        border-top: 3px solid var(--color-accent);
    }

    .resp-ours {
        border-top: 3px solid var(--color-primary);
    }

    .resp-head {
        margin-bottom: var(--px-20);
        padding-bottom: var(--px-14);
        border-bottom: 1px solid var(--color-border);
    }

    .resp-head-label {
        font-size: var(--text-xs);
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--color-text-secondary);
    }

    .resp-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: var(--px-12);
    }

    .resp-list li {
        font-size: var(--text-base);
        line-height: 1.5;
        color: var(--color-text-dark);
        padding-left: var(--px-18);
        position: relative;
    }

    .resp-list li::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.55em;
        width: 6px;
        height: 6px;
        border-radius: 50%;
    }

    .resp-yours .resp-list li::before {
        background: var(--color-accent);
    }

    .resp-ours .resp-list li::before {
        background: var(--color-primary);
    }

    .resp-and-thats-it {
        color: var(--color-text-secondary) !important;
        font-style: italic;
        padding-left: 0 !important;
    }

    .resp-and-thats-it::before {
        display: none;
    }

    .process-grid-wrapper {
        display: flex;
        flex-direction: column;
        gap: var(--px-24);
    }

    .process-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--px-12);
        align-content: start;
    }

    .process-grid-item {
        position: relative;
        margin: 0;
        padding: 0;
        border: none;
        background: transparent;
        cursor: zoom-in;
        aspect-ratio: 4 / 3;
        overflow: hidden;
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-md);
    }

    .process-grid-cta {
        align-self: flex-end;
        display: inline-flex;
        align-items: center;
        gap: var(--px-6);
        padding: var(--px-6) 0;
        color: var(--color-text-secondary);
        font-size: var(--text-xs);
        font-weight: 500;
        letter-spacing: 0.04em;
        transition: color var(--transition-short);
    }

    .process-grid-cta svg {
        transition: transform var(--transition-short);
    }

    @media (hover: hover) and (pointer: fine) {
        .process-grid-cta:hover {
            color: var(--color-primary);
        }
        .process-grid-cta:hover svg {
            transform: translateX(3px);
        }
    }

    .process-grid-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform var(--transition-long);
    }

    .process-grid-caption {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: var(--px-14) var(--px-16);
        font-size: var(--text-xs);
        font-weight: 600;
        letter-spacing: 0.06em;
        color: var(--color-white);
        background: linear-gradient(
            180deg,
            rgba(0, 0, 0, 0) 0%,
            rgba(0, 0, 0, 0.65) 100%
        );
    }

    @media (hover: hover) and (pointer: fine) {
        .process-grid-item:hover .process-grid-img {
            transform: scale(1.04);
        }
    }

    /* Lightbox */
    .process-lightbox {
        position: fixed;
        inset: 0;
        background: rgba(45, 59, 45, 0.96);
        z-index: var(--z-max);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: var(--px-32);
        opacity: 0;
        visibility: hidden;
        transition: opacity var(--transition-medium), visibility var(--transition-medium);
        cursor: zoom-out;
    }
    .process-lightbox.active {
        opacity: 1;
        visibility: visible;
    }
    .process-lightbox-img {
        max-width: 95vw;
        max-height: 88vh;
        width: auto;
        height: auto;
        object-fit: contain;
        box-shadow: var(--shadow-lg);
        border-radius: var(--radius-sm);
    }
    .process-lightbox-close {
        position: absolute;
        top: var(--px-24);
        right: var(--px-24);
        width: var(--px-48);
        height: var(--px-48);
        border-radius: 50%;
        border: none;
        background: rgba(255, 255, 255, 0.15);
        color: var(--color-white);
        font-size: 1.75rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
        transition: background var(--transition-short);
    }
    .process-lightbox-close:hover {
        background: rgba(255, 255, 255, 0.3);
    }

    @media screen and (max-width: 64rem) {
        .process-split {
            grid-template-columns: 1fr;
            gap: var(--px-40);
        }

        .process-grid {
            order: -1;
        }
    }

    @media screen and (max-width: 48rem) {
        .process {
            padding-block: var(--px-80);
        }

        .responsibilities {
            grid-template-columns: 1fr;
        }

        .process-text {
            margin-bottom: var(--px-56);
        }
    }
</style>

<script>
    function initProcessLightbox() {
        const lightbox = document.getElementById("process-lightbox") as HTMLElement | null;
        const img = document.getElementById("process-lightbox-img") as HTMLImageElement | null;
        const closeBtn = lightbox?.querySelector(".process-lightbox-close") as HTMLElement | null;
        if (!lightbox || !img) return;

        function openLightbox(target: HTMLImageElement) {
            img!.srcset = target.srcset;
            img!.sizes = "100vw";
            img!.src = target.currentSrc || target.src;
            img!.alt = target.alt;
            lightbox!.classList.add("active");
            lightbox!.setAttribute("aria-hidden", "false");
            document.body.classList.add("no-scroll");
        }
        function closeLightbox() {
            lightbox!.classList.remove("active");
            lightbox!.setAttribute("aria-hidden", "true");
            document.body.classList.remove("no-scroll");
        }

        function onClick(e: MouseEvent) {
            const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".process-lightbox-trigger");
            if (!btn) return;
            const innerImg = btn.querySelector("img") as HTMLImageElement | null;
            if (innerImg) openLightbox(innerImg);
        }
        function onLightboxClick(e: MouseEvent) {
            if (e.target === img) return;
            closeLightbox();
        }
        function onKey(e: KeyboardEvent) {
            if (e.key === "Escape" && lightbox!.classList.contains("active")) closeLightbox();
        }

        document.addEventListener("click", onClick);
        lightbox.addEventListener("click", onLightboxClick);
        document.addEventListener("keydown", onKey);
        closeBtn?.addEventListener("click", closeLightbox);
    }

    initProcessLightbox();
</script>
